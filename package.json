{
  "name": "dictionary-app",
  "version": "1.0.0",
  "description": "Full-stack Dictionary Web Application",
  "main": "backend/server.js",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "seed": "node backend/seed.js",
    "backend": "node backend/server.js",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1"
  }
}

